<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_gradient"
    tools:context=".SplashActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_logo_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.45">

        <ImageView
            android:id="@+id/img_cnp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/cnp"
            android:alpha="0"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:id="@+id/img_hoja"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/hoja"
            android:scaleX="0"
            android:scaleY="0"
            android:transformPivotY="40dp"
            app:layout_constraintBottom_toTopOf="@+id/img_cnp"
            app:layout_constraintEnd_toEndOf="@+id/img_cnp"
            app:layout_constraintStart_toStartOf="@+id/img_cnp"
            app:layout_constraintHorizontal_bias="0.64"
            android:layout_marginBottom="-8dp" />

        <ImageView
            android:id="@+id/img_tenedor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/tenedor"
            android:alpha="0"
            android:translationX="-30dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/img_cnp"
            app:layout_constraintEnd_toStartOf="@+id/img_cnp"
            app:layout_constraintTop_toTopOf="@+id/img_cnp" />

        <ImageView
            android:id="@+id/img_cuchara"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/cuchara"
            android:alpha="0"
            android:translationX="30dp"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/img_cnp"
            app:layout_constraintStart_toEndOf="@+id/img_cnp"
            app:layout_constraintTop_toTopOf="@+id/img_cnp" />

        <ImageView
            android:id="@+id/img_subtitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0"
            android:src="@drawable/nutricion_profesional"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/img_cnp"
            app:layout_constraintStart_toStartOf="@id/img_cnp"
            app:layout_constraintEnd_toEndOf="@id/img_cnp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress_loader"
        android:layout_width="140dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        android:indeterminate="true"
        app:trackThickness="3dp"
        app:trackColor="@color/blanco_transparente_20"
        app:indicatorColor="@color/white"
        app:trackCornerRadius="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>