<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="24dp" android:clipToPadding="false"
        android:scrollbars="none">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tvSaludo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="32dp"
                android:layout_marginEnd="16dp"
                android:text="@string/dash_greeting"
                android:textAppearance="?attr/textAppearanceHeadlineMedium"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@+id/card_profile_image"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/ic_sync"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="4dp"
                android:contentDescription="@string/desc_sync_icon"
                android:src="@android:drawable/presence_online"
                app:tint="?attr/colorPrimary"
                app:layout_constraintStart_toStartOf="@+id/tvSaludo"
                app:layout_constraintTop_toBottomOf="@+id/tvSaludo" />

            <TextView
                android:id="@+id/tv_sync_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/dash_sync_status"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/colorOutline"
                app:layout_constraintBottom_toBottomOf="@+id/ic_sync"
                app:layout_constraintStart_toEndOf="@+id/ic_sync"
                app:layout_constraintTop_toTopOf="@+id/ic_sync" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/card_profile_image"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="24dp"
                android:contentDescription="@string/desc_profile_image"
                android:scaleType="centerCrop"
                android:padding="2dp"
                android:src="@android:drawable/ic_menu_camera"
                app:strokeWidth="2dp" app:strokeColor="?attr/colorPrimary" app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                app:layout_constraintBottom_toBottomOf="@+id/tv_sync_status"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvSaludo" />

            <LinearLayout
                android:id="@+id/layout_metrics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="32dp"
                android:orientation="horizontal"
                android:weightSum="2"
                app:layout_constraintTop_toBottomOf="@+id/tv_sync_status">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_pacientes_activos"
                    style="@style/Widget.Material3.CardView.Filled"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="?attr/colorPrimaryContainer">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dash_metric_active_patients"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            android:textColor="?attr/colorOnPrimaryContainer" />
                        <TextView
                            android:id="@+id/tvCountPacientes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="0"
                            android:textAppearance="?attr/textAppearanceDisplayMedium"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_consultas_mes"
                    style="@style/Widget.Material3.CardView.Elevated"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="?attr/colorSurface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dash_metric_monthly_consults"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            android:textColor="?attr/colorOutline" />
                        <TextView
                            android:id="@+id/tvCountConsultas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="0"
                            android:textAppearance="?attr/textAppearanceDisplayMedium"
                            android:textColor="?attr/colorPrimary"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/scroll_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:clipToPadding="false"
                android:paddingHorizontal="24dp"
                android:scrollbars="none"
                app:layout_constraintTop_toBottomOf="@+id/layout_metrics">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAccionNuevoPac"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="110dp"
                        android:layout_height="110dp"
                        android:layout_marginEnd="12dp"
                        android:text="@string/dash_action_new_patient"
                        android:textAlignment="center"
                        app:icon="@android:drawable/ic_menu_add"
                        app:iconGravity="textTop"
                        app:iconSize="28dp"
                        app:iconTint="?attr/colorPrimary"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAccionDietas"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="110dp"
                        android:layout_height="110dp"
                        android:layout_marginEnd="12dp"
                        android:text="@string/dash_action_recipes"
                        android:textAlignment="center"
                        app:icon="@android:drawable/ic_menu_agenda"
                        app:iconGravity="textTop"
                        app:iconSize="28dp"
                        app:iconTint="?attr/colorPrimary"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAccionNuevaConsulta"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="110dp"
                        android:layout_height="110dp"
                        android:text="@string/dash_action_new_consult"
                        android:textAlignment="center"
                        app:icon="@android:drawable/ic_menu_edit"
                        app:iconGravity="textTop"
                        app:iconSize="28dp"
                        app:iconTint="?attr/colorPrimary"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/tv_title_citas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="32dp"
                android:text="@string/dash_section_today_appointments"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/scroll_actions" />

            <TextView
                android:id="@+id/tvVerTodoCitas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="24dp"
                android:text="@string/dash_action_see_all"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorSecondary"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@+id/tv_title_citas"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_title_citas" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_citas_hoy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="16dp"
                android:nestedScrollingEnabled="false"
                app:layout_constraintTop_toBottomOf="@+id/tv_title_citas"
                tools:itemCount="2" />

            <TextView
                android:id="@+id/tv_title_pacientes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="32dp"
                android:text="@string/dash_section_recent_patients"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rv_citas_hoy" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_pacientes_recientes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clipToPadding="false"
                android:paddingHorizontal="24dp"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintTop_toBottomOf="@+id/tv_title_pacientes"
                tools:itemCount="3" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>