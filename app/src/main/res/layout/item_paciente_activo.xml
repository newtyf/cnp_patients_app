<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="@color/md_theme_surface"
    app:strokeColor="@color/md_theme_outlineVariant"
    app:strokeWidth="1dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Nombre del Paciente -->
        <TextView
            android:id="@+id/tv_nombre_paciente"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Ana Torres"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="@color/md_theme_onSurface"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/btn_expandir"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Botón Expandir -->
        <ImageButton
            android:id="@+id/btn_expandir"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_expandir_detalles"
            android:src="@android:drawable/arrow_down_float"
            app:tint="@color/md_theme_outline"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- DNI -->
        <TextView
            android:id="@+id/tv_dni_paciente"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="DNI: 12345678"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/md_theme_onSurfaceVariant"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_nombre_paciente" />

        <!-- Etiqueta Última Consulta -->
        <TextView
            android:id="@+id/lbl_ultima_consulta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/lbl_ultima_consulta"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="@color/md_theme_onSurfaceVariant"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_dni_paciente" />

        <!-- Estado de la Consulta -->
        <TextView
            android:id="@+id/tv_estado_consulta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/estado_pendiente"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="@color/md_theme_onSurface"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lbl_ultima_consulta" />

        <!-- Botón Nueva Consulta (Outlined) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_nueva_consulta_card"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_nueva_consulta"
            android:textColor="@color/md_theme_primary"
            app:strokeColor="@color/md_theme_primary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/lbl_ultima_consulta" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>