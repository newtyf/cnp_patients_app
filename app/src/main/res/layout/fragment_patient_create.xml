<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.patients.create.PatientCreateFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="CNP - Datos del Paciente"
            android:textSize="20sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvNombreLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Nombre completo"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/txtNombrePac"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:inputType="textPersonName"
            android:hint="Ej: Juan Pérez"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tvNombreLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvDniLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="DNI"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/txtNombrePac"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/txtDniPac"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:hint="12345678"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tvDniLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvEmailLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Correo electrónico"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/txtDniPac"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/txtEmailPac"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:inputType="textEmailAddress"
            android:hint="paciente@ejemplo.com"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tvEmailLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvTelefonoLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Teléfono"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/txtEmailPac"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/txtTelefonoPac"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:inputType="phone"
            android:hint="987654321"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tvTelefonoLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvFechaNacLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Fecha de nacimiento"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/txtTelefonoPac"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/txtFechaNacPac"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="DD/MM/AAAA"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tvFechaNacLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvObjetivoLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Objetivo nutricional"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/txtFechaNacPac"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/txtObjetivoPac"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Ej: Reducir peso, control de glucosa"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tvObjetivoLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Guardar Paciente"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/txtObjetivoPac"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btnBack"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Volver"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/btnSave"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
