<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <!-- Card Datos Personales -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            style="?attr/materialCardViewOutlinedStyle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/detail_patient_section_personal"
                    android:textAllCaps="true"
                    style="?attr/textAppearanceLabelLargeEmphasized"
                    android:textColor="?attr/colorOnSurface" />

                <LinearLayout style="@style/DetailRow">
                    <TextView
                        style="@style/DetailRowLabel"
                        android:text="@string/detail_patient_label_edad" />
                    <TextView
                        android:id="@+id/tvEdad"
                        style="@style/DetailRowValue"
                        android:text="@string/detail_patient_value_placeholder" />
                </LinearLayout>

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="4dp" />

                <LinearLayout style="@style/DetailRow">
                    <TextView
                        style="@style/DetailRowLabel"
                        android:text="@string/detail_patient_label_sexo" />
                    <TextView
                        android:id="@+id/tvSexo"
                        style="@style/DetailRowValue"
                        android:text="@string/detail_patient_value_placeholder" />
                </LinearLayout>

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="4dp" />

                <LinearLayout style="@style/DetailRow">
                    <TextView
                        style="@style/DetailRowLabel"
                        android:text="@string/detail_patient_label_telefono" />
                    <TextView
                        android:id="@+id/tvTelefono"
                        style="@style/DetailRowValue"
                        android:text="@string/detail_patient_value_placeholder" />
                </LinearLayout>

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="4dp" />

                <LinearLayout style="@style/DetailRow">
                    <TextView
                        style="@style/DetailRowLabel"
                        android:text="@string/detail_patient_label_correo" />
                    <TextView
                        android:id="@+id/tvCorreo"
                        style="@style/DetailRowValue"
                        android:text="@string/detail_patient_value_placeholder" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card Estado Nutricional -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="?attr/colorPrimaryContainer"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/detail_patient_estado_label"
                        android:textAllCaps="true"
                        style="?attr/textAppearanceLabelSmall"
                        android:textColor="?attr/colorOnPrimaryContainer" />

                    <TextView
                        android:id="@+id/tvEstadoNutricional"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/detail_patient_estado_placeholder"
                        android:textStyle="bold"
                        style="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnPrimaryContainer" />

                </LinearLayout>

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_restaurant"
                    app:tint="?attr/colorOnPrimaryContainer"
                    android:contentDescription="@null" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
